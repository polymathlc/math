+import assert from 'node:assert/strict';
+import {withBrowser, preparePage} from './browser-harness.mjs';
+
+await withBrowser(async ({browser, url, root}) => {
+  for (const options of [{viewport: {width: 1100, height: 800}}, {viewport: {width: 390, height: 844}, isMobile: true, hasTouch: true}]) {
+    const {page, errors} = await preparePage(browser, options);
+    await page.goto(url);
+    await page.waitForFunction(() => gameRuntime.ready);
+    await page.locator('#runtime-start').click();
+    await page.evaluate(() => { gameState.enemies = []; player.iFrames = 1e6; });
+    const cast = page.locator(options.hasTouch ? '.touch-action[data-action="cast"]' : '[data-ability="cast"]');
+    await page.waitForFunction(() => document.querySelector('[data-ability="cast"]').dataset.readiness === 'ready');
+    assert.match(await cast.textContent(), /15 Magick/);
+    if (options.hasTouch) await cast.tap();
+    else { await page.mouse.move(710, 500); await page.keyboard.press('q'); }
+    await page.waitForFunction(() => document.querySelector('[data-ability="cast"]').dataset.readiness === 'active');
+    assert.match(await cast.textContent(), /Burst/);
+    if (options.hasTouch) await cast.tap();
+    else await page.keyboard.press('q');
+    await page.waitForFunction(() => !player.castActive);
+    await page.evaluate(() => { player.magick = 0; player.dashCooldown = .3; gameState.isPaused = true; });
+    await page.waitForFunction(() => document.querySelector('[data-ability="cast"]').dataset.readiness === 'waiting');
+    assert.match(await cast.textContent(), /Low Magick/);
+    assert.match(await page.locator('[data-ability="dash"] .ability-status').textContent(), /0.3s/);
+    await page.evaluate(() => { player.magick = 40; player.dashCooldown = 0; player.hexCharge = player.hexMax; });
+    await page.waitForFunction(() => document.querySelector('[data-ability="cast"]').dataset.readiness === 'ready');
+    assert.equal(await page.locator('[data-ability="hex"] .ability-status').textContent(), 'Ready');
+    assert.deepEqual(errors, []);
+    await page.close();
+  }
+  console.log('PASS desktop and touch ability state, cast/detonation, low Magick, cooldown and Hex readiness');
+});
