+import assert from 'node:assert/strict';
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import {withBrowser,preparePage} from './browser-harness.mjs';
+await withBrowser(async({browser,url,root})=>{
+ const {page,errors}=await preparePage(browser);
+ await page.goto(url);await page.waitForFunction(()=>gameRuntime.ready);
+ const output=path.join(root,'test-results');await fs.mkdir(output,{recursive:true});
+ await page.screenshot({path:path.join(output,'premium-welcome.png')});
+ await page.locator('#runtime-start').click();
+ await page.evaluate(()=>{gameState.isPaused=true;gameState.enemies=[];gameState.doors=[{x:-200,y:-40,radius:45,reward:{type:'god',godKey:'poseidon',label:'POSEIDON'}},{x:200,y:-40,radius:45,reward:{type:'heart',label:'CENTAUR HEART'}}];player.x=0;player.y=70;player.isDashing=true;player.dashVx=820;});
+ await page.screenshot({path:path.join(output,'premium-gates.png')});
+ const result=await page.evaluate(()=>{
+  const before=gameState.particles.length;
+  for(let i=0;i<500;i++)drawPremiumAtmosphere(ctx,i*16);
+  const after=gameState.particles.length;
+  const draw=time=>{ctx.clearRect(0,0,canvas.width,canvas.height);ctx.save();ctx.translate(canvas.width/2,canvas.height/2);drawPremiumAtmosphere(ctx,time);ctx.restore();return canvas.toDataURL();};
+  gameRuntime.settings.reducedMotion=true;const a=draw(100),b=draw(5000);
+  gameRuntime.settings.reducedMotion=false;const c=draw(100),d=draw(5000);
+  return {before,after,frozen:a===b,animated:c!==d};
+ });
+ assert.equal(result.before,result.after);assert.equal(result.frozen,true);assert.equal(result.animated,true);
+ assert.deepEqual(errors,[]);console.log('Premium atmosphere is animated, bounded and static with reduced motion.');
+});
