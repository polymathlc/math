index 0000000..2a4ba66
--- /dev/null
+++ b/src/premium.css
@@ -0,0 +1,18 @@
+/* Engraved glass and warm metallic highlights; geometry stays HUD-safe. */
+.runtime-panel{position:relative;isolation:isolate;overflow:hidden;border-color:#d3b777;box-shadow:0 28px 100px #000c,inset 0 0 0 5px #c7a76812,inset 0 1px #fff1;background:radial-gradient(ellipse at 50% 0,#31515399,transparent 64%),linear-gradient(145deg,#152b34fa,#070f1cfb)}
+.runtime-panel::before{content:"";position:absolute;width:440px;height:440px;left:50%;top:-285px;margin-left:-220px;border:1px solid #ddb97455;border-radius:50%;box-shadow:0 0 0 17px #dab86d0a,0 0 0 43px #dab86d08;z-index:-1;pointer-events:none;animation:sanctuary-halo 18s linear infinite;background:repeating-conic-gradient(from 0deg,transparent 0deg 14deg,#b9e8df33 14deg 15deg,transparent 15deg 30deg)}
+.runtime-panel::after{content:"";position:absolute;inset:10px;border:1px solid #b9d4cb15;border-radius:14px;pointer-events:none;z-index:-1}
+.runtime-eyebrow{color:#afe9d8;text-shadow:0 0 18px #68d7b866}
+.runtime-primary{background:linear-gradient(115deg,#b99550,#f4dfa6 45%,#c4a568);box-shadow:0 6px 22px #cbaa4f28,inset 0 1px #fff9;transition:filter .18s,transform .18s,box-shadow .18s}
+.runtime-primary:hover:not(:disabled){transform:translateY(-2px);box-shadow:0 10px 30px #cbaa4f40}
+.runtime-primary:active:not(:disabled){transform:translateY(1px)}
+.stat-bar-container,.currency-panel,.ability-slot{box-shadow:0 5px 18px #0007,inset 0 1px #f8e5b521}
+.health-fill,.magick-fill{background-size:160% 100%;box-shadow:inset 0 1px #fff5}
+.boon-card{overflow:hidden;border-color:#b4bca166;box-shadow:0 10px 22px #0003,inset 0 1px #ffffff0c;animation:divine-arrival .4s both}
+.boon-card:nth-child(2){animation-delay:.06s}.boon-card:nth-child(3){animation-delay:.12s}
